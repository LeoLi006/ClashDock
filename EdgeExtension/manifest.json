{
  "manifest_version": 3,
  "name": "ClashDock 网站分流",
  "version": "1.2.0",
  "description": "管理当前域名的 ClashDock 规则；共用桌面端全局代理目标。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "sidePanel",
    "tabs"
  ],
  "action": {
    "default_title": "ClashDock 网站分流",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
